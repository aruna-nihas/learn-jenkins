pipeline {
    agent {
        label 'AGENT-1'
    }
        stages {
            stage ('Build'){
                steps {
                    echo "the project is in building stage..."
                }

            }
            stage ('Testing'){
                steps {
                    echo "testing the project..."
                }
            }
            stage ('Deploying'){
                steps {
                    echo "Deploying the project..."
                }
            }
        }
    
}